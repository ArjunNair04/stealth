{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stealth: configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Stealth: build",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Stealth: configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ]
    },
    {
      "label": "Stealth: test",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Stealth: build",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
